# Independent static frontend for user.dorocloud.net.
# Original dorocloud.net:80 and API dorocloud.net:8080 are unchanged.
server {
    listen 8090;
    server_name user.dorocloud.net localhost 127.0.0.1;

    root D:/wwwroot/user.dorocloud.net;
    index index.html;
    charset utf-8;

    # Same-origin API for the independent frontend.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host dorocloud.net;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # History-mode frontend routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Revalidate runtime configuration and HTML after deployment.
    location = /env.js {
        expires -1;
        try_files $uri =404;
    }
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    location ~ /\. {
        return 404;
    }
    location ~* \.(?:env|ini|log|sql|bak|bat|cmd|ps1|phar|lock|sqlite|ya?ml)(?:$|/) {
        return 404;
    }

    access_log D:/BtSoft/wwwlogs/user.dorocloud.net-8090.log;
    error_log D:/BtSoft/wwwlogs/user.dorocloud.net-8090.error.log;
}
