APP_NAME=DoroCloud
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://dorocloud.net
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dorocloud_net
DB_USERNAME=dorocloud_net
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=8
REDIS_CACHE_DB=9
REDIS_PREFIX=xboard_dorocloud_net_
CACHE_PREFIX=dorocloud_cache_
HORIZON_PREFIX=dorocloud_horizon:
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
MAIL_DRIVER=smtp
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@dorocloud.net
MAIL_FROM_NAME=DoroCloud
ENABLE_AUTO_BACKUP_AND_UPDATE=false
WINDOWS_BACKUP_DIR=D:/backup/Xboard-dorocloud.net
WINDOWS_MYSQLDUMP=D:/BtSoft/mysql/MySQL5.7/bin/mysqldump.exe
INSTALLED=false
